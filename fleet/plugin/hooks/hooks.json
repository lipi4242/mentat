{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\""
          },
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/identitas/kapu.py\" --session-start",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "sh -c 'command -v node >/dev/null 2>&1 || { [ -f \"$HOME/.config/todo/env\" ] && echo \"[todo] node nincs a PATH-on: a todo-figyelés ebben a sessionben nem fut\"; exit 0; }; node \"$0\" \"$1\"; exit 0' \"${CLAUDE_PLUGIN_ROOT}/hooks/todo/todo-once.mjs\" --session-start",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/identitas/kapu.py\" --hook --instance plugin",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit|MultiEdit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/identitas/titok_kapu.py\" --hook",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/identitas/nemakad.py\" --hook",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v node >/dev/null 2>&1 || { exit 0; }; node \"$0\" \"$1\"; exit 0' \"${CLAUDE_PLUGIN_ROOT}/hooks/todo/todo-once.mjs\" --prompt",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
