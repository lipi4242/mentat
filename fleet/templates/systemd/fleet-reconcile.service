# A @@FLEET_ROOT@@-t a `fleet install` a checkout tényleges útvonalára cseréli.
# Egy vezérlő: a liveness funkciói (OOM-védelem, tick re-arm) is itt futnak.
[Unit]
Description=Mentat fleet reconcile — a registry kívánt állapotának érvényesítése

[Service]
Type=oneshot
WorkingDirectory=@@FLEET_ROOT@@
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@@FLEET_ROOT@@/bin/fleet reconcile
