# templates/agent.service.tmpl — a Mentat fleet által renderelt ágens-unit.
# Ne szerkeszd a telepített példányt: `fleet install <agent>` felülírja.
# Az env-fájl betöltése ŐRZÖTT (`if [ -r … ]`): a /bin/sh (dash) a hiányzó
# fájl `.`-jára azonnal kilép, a 2>/dev/null pedig elnyelte az üzenetet —
# egy friss boxon a claude így el sem indult, nyom nélkül.
# A claude-auth.env (0600) az ágens Claude-tokenje (CLAUDE_CODE_OAUTH_TOKEN): külön
# fájl, mert az ágens env-fájlját a híd is betöltheti — a híd ezt nem kapja meg.
# A <workdir>/.mentat/model.env (MENTAT_MODEL) az agy modellváltójáé (skills/model): ha van,
# az felülírja a registry modelljét — különben egy teljes Claude-azonosító
# (--model claude-…) az OpenRouteren valódi Claude-ot hívna.
[Unit]
Description=@@DESCRIPTION@@
After=network-online.target
Wants=network-online.target

[Service]
# Egy tmux-szerver, több ágens: a KillMode=none nélkül egy egység leállítása a
# többi session alól is kihúzná a szervert.
KillMode=none
Type=oneshot
RemainAfterExit=yes
Environment=CLAUDE_CODE_AUTO_COMPACT_WINDOW=500000
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
@@ACCOUNT_ENV@@UnsetEnvironment=ANTHROPIC_API_KEY CLAUDE_API_KEY
EnvironmentFile=-@@ENV_FILE@@
@@EXECSTARTPRE@@ExecStart=/usr/bin/tmux new-session -d -s @@SESSION@@ -c @@WORKDIR@@ /bin/sh -c 'set -a; if [ -r @@ENV_FILE@@ ]; then . @@ENV_FILE@@; fi; if [ -r %h/.config/@@AGENT@@/claude-auth.env ]; then . %h/.config/@@AGENT@@/claude-auth.env; fi; if [ -r @@WORKDIR@@/.mentat/model.env ]; then . @@WORKDIR@@/.mentat/model.env; fi; set +a; m=@@MODEL@@; if [ -n "$MENTAT_MODEL" ]; then m="$MENTAT_MODEL"; fi; unset ANTHROPIC_API_KEY CLAUDE_API_KEY; @@ACCOUNT_SHELL@@ export FLEET_AGENT=@@AGENT@@; sid=$(cat %h/.config/@@AGENT@@/session.id 2>/dev/null); if [ -n "$sid" ] && ls %h/.claude/projects/*/"$sid".jsonl >/dev/null 2>&1; then %h/.local/bin/claude @@FLAGS@@ --model "$m" --resume "$sid" || exec %h/.local/bin/claude @@FLAGS@@ --model "$m"; else exec %h/.local/bin/claude @@FLAGS@@ --model "$m"; fi'
@@EXECSTARTPOST@@ExecStop=/usr/bin/tmux kill-session -t =@@SESSION@@

[Install]
WantedBy=default.target
