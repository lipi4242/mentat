{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentat.local/fleet/managers.schema.json",
  "title": "Flotta-menedzserek hozzárendelése (flotta-menedzser)",
  "description": "fleet-ops fleet/managers.json. Egyetlen kiadó tölti fel: `fleet managers publish` (flotta:config token). A version minden változásnál nő; régebbit a Worker elutasít. Lánc: agent > box > *, azon belül rank, döntetlennél handle; egy handle egyszer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "managers"],
  "properties": {
    "schema": {"const": 1},
    "version": {"type": "integer", "minimum": 1},
    "fleet": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "default": "default"},
    "managers": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["handle", "scope", "rank"],
        "properties": {
          "handle": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "description": "a menedzser todo-handle-je (ágens-principal)"},
          "agent": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$", "description": "a flottabeli ágensneve; alapból a handle"},
          "scope": {"type": "string", "pattern": "^(\\*|(agent|box):[A-Za-z0-9][A-Za-z0-9._-]{0,63})$"},
          "rank": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
