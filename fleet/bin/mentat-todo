#!/bin/sh
# mentat-todo — a todo/ügy/backlog ágens-CLI (anytime_todo) egy box minden ágensének,
# vendorolás nélkül. Ugyanaz, mint egy ágens-repó gyökeréből a
# `python3 -m anytime_todo.cli …`, csak a box Mentat-checkoutjából fut.
#
# Ki vagyok: a unit FLEET_AGENT-je (vagy --as / TODO_HANDLE) → handle a
# ~/.config/todo/handles fájlból („ágens=handle” soronként; hiányzó sor: az ágens neve).
# Beállítás: ~/.config/todo/env (TODO_API=…), token: ~/.config/todo/<handle>.token (0600).
# Telepítés: ln -s ~/src/mentat/fleet/bin/mentat-todo ~/.local/bin/mentat-todo
set -eu
here=$(dirname "$(readlink -f "$0")")
src=""
for d in "$here/../../engine/src" "$here/../../engine/release/src"; do
  [ -d "$d/anytime_todo" ] && { src=$(cd "$d" && pwd); break; }
done
[ -n "$src" ] || { echo "mentat-todo: nem találom az anytime_todo csomagot a checkoutban" >&2; exit 2; }
cfg="${XDG_CONFIG_HOME:-$HOME/.config}/todo"
# Egy session saját XDG_CONFIG_HOME-mal (pl. több Claude-fiókos indító) a közös ~/.config/todo-t is lássa.
[ -d "$cfg" ] || cfg="$HOME/.config/todo"
if [ "${1:-}" = "--as" ]; then TODO_HANDLE=$2; shift 2; fi
if [ -z "${TODO_HANDLE:-}" ]; then
  agent=${FLEET_AGENT:-}
  [ -n "$agent" ] || { echo "mentat-todo: nincs FLEET_AGENT (vagy add meg: --as <handle>)" >&2; exit 2; }
  TODO_HANDLE=$(sed -n "s/^$agent=//p" "$cfg/handles" 2>/dev/null | head -n1)
  [ -n "$TODO_HANDLE" ] || TODO_HANDLE=$agent
fi
if [ -z "${TODO_API:-}" ] && [ -r "$cfg/env" ]; then
  TODO_API=$(sed -n 's/^TODO_API=//p' "$cfg/env" | head -n1)
fi
[ -n "${TODO_API:-}" ] || { echo "mentat-todo: nincs TODO_API ($cfg/env)" >&2; exit 2; }
TODO_TOKEN_FILE=${TODO_TOKEN_FILE:-$cfg/$TODO_HANDLE.token}
[ -r "$TODO_TOKEN_FILE" ] || { echo "mentat-todo: nincs token: $TODO_TOKEN_FILE" >&2; exit 2; }
export TODO_API TODO_HANDLE TODO_TOKEN_FILE
export ANYTIME_REPO_ROOT="${ANYTIME_REPO_ROOT:-$PWD}"
# -P: a cwd NE kerüljön a sys.path elejére — egy ágens-repóban vendorolt régi
# anytime_engine/ különben elfedi a checkoutét (11-07, thufir-assistant: ImportError).
PYTHONPATH="$src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -P -m anytime_todo.cli "$@"
